{
  "name": "restaurant-pos",
  "version": "1.0.0",
  "description": "100% offline Restaurant POS - Electron + SQLite, Ubuntu-inspired UI, Windows target",
  "main": "electron/main.js",
  "author": "Client Restaurant",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "predist:win": "node scripts/check-license-config.js && node scripts/download-chrome.js",
    "dist:win": "npm run build:renderer && electron-builder --win --x64",
    "db:test": "node electron/database/__selftest__.js",
    "db:test:extended": "node electron/database/__selftest_extended__.js",
    "db:test:backup": "node electron/backup/__selftest_backup__.js",
    "db:test:license": "node electron/license/__selftest_license__.js",
    "db:test:all": "npm run db:test && npm run db:test:extended && npm run db:test:backup && npm run db:test:license",
    "license:redteam": "node electron/license/__redteam_license__.js",
    "license:keys": "node tools/license/generate-keys.js",
    "license:issue": "node tools/license/issue-license.js",
    "qa:license": "node qa/license-qa.js",
    "qa:whatsapp": "node qa/whatsapp-license-qa.js && node qa/whatsapp-timing-qa.js",
    "qa:ui": "node --experimental-default-type=module --import ./qa/register-json.mjs qa/ui-smoke.mjs",
    "qa:all": "npm run qa:license && npm run qa:whatsapp && npm run qa:release && npm run license:redteam",
    "recovery:keys": "node tools/license/generate-recovery-key.js",
    "recovery:issue": "node tools/license/issue-pin-reset.js",
    "license:list": "node tools/license/list-licenses.js",
    "qa:release": "node qa/release-check-qa.js",
    "license:check": "node scripts/check-license-config.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "better-sqlite3": "^11.10.0",
    "whatsapp-web.js": "^1.26.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "autoprefixer": "^10.5.4",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "com.restaurant.pos",
    "productName": "Restaurant POS",
    "copyright": "Copyright \u00a9 2026 Client Restaurant",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!electron/license/devBypass.js",
      "!electron/license/__*.js",
      "!electron/**/__selftest*.js",
      "!electron/security/master-secret.generated.js"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/whatsapp-web.js/**/*",
      "node_modules/puppeteer/**/*",
      "node_modules/puppeteer-core/**/*"
    ],
    "extraResources": [
      {
        "from": ".puppeteer-cache",
        "to": "puppeteer-cache"
      }
    ],
    "publish": null,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "perMachine": true
    },
    "afterPack": "scripts/after-pack-fuses.js"
  }
}
